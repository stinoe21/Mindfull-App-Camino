# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env wordt nooit gecommit.
#
# Dit is voor de APP zelf, niet voor de MCP's. Die autoriseren via de
# browser met je eigen account en hebben hier niets nodig.
#
# Nog niet nodig zolang de Expo-app niet gescaffold is.

# Supabase, publieke waarden voor de client. De anon key is niet geheim,
# maar hoort wel per omgeving te verschillen.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
