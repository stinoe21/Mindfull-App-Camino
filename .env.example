# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env wordt nooit gecommit. Iedereen maakt zijn eigen tokens aan.
# Zie ONBOARDING.md stap 3 voor waar je ze vandaan haalt.

# GitHub fine-grained personal access token, alleen scope op deze repo.
# Permissions: Contents RW, Pull requests RW, Issues RW, Metadata R
GITHUB_TOKEN=

# Supabase personal access token: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Staat in de dashboard-URL: supabase.com/dashboard/project/<dit-stukje>
SUPABASE_PROJECT_REF=

# Figma heeft hier niets nodig. Die MCP autoriseert via OAuth in de browser
# bij het eerste gebruik.
