# Kopieer naar .env.local en vul in. Alleen de twee publieke waarden, dezelfde
# als in apps/mobile: het adres van het project en de publishable key.
#
# NOOIT de service role key, ook niet tijdelijk. Het beheer heeft hem niet
# nodig: wat een medewerker mag, staat in de database (admin_users).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
